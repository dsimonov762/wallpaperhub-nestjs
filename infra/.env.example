# Optional. docker compose reads infra/.env automatically if it exists; every value has a default.
ACCOUNT_DB_NAME=account
ACCOUNT_DB_USER=account
ACCOUNT_DB_PASSWORD=account
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Always enable both profiles, so `docker compose -f infra/docker-compose.yml stop account-service` and friends work
# without --profile flags (a service in the apps profile depends on services in the infra profile):
# COMPOSE_PROFILES=infra,apps
