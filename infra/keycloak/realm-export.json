{
  "realm": "wallpaperhub",
  "enabled": true,
  "displayName": "Wallpaper Hub (dev)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Regular user"
      },
      {
        "name": "MODERATOR",
        "description": "Can moderate wallpapers"
      },
      {
        "name": "ADMIN",
        "description": "Administrator"
      },
      {
        "name": "internal",
        "description": "Service accounts: internal calls only"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web-spa",
      "name": "Web SPA (end users)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "aud-account-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud-media-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "media-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud-catalog-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "catalog-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud-notification-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "notification-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dev-cli",
      "name": "DEV ONLY: password grant for curl/tests",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-account-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud-media-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "media-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud-catalog-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "catalog-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud-notification-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "notification-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "gateway",
      "name": "API gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret-gateway",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "account-svc",
      "name": "account-svc",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret-account-svc",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": []
    },
    {
      "clientId": "media-svc",
      "name": "media-svc",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret-media-svc",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": []
    },
    {
      "clientId": "catalog-svc",
      "name": "catalog-svc",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret-catalog-svc",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "aud-account-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud-media-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "media-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "notification-svc",
      "name": "notification-svc",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret-notification-svc",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "aud-account-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud-catalog-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "catalog-svc",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-account-svc",
      "enabled": true,
      "serviceAccountClientId": "account-svc",
      "realmRoles": [
        "internal"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "service-account-media-svc",
      "enabled": true,
      "serviceAccountClientId": "media-svc",
      "realmRoles": [
        "internal"
      ]
    },
    {
      "username": "service-account-catalog-svc",
      "enabled": true,
      "serviceAccountClientId": "catalog-svc",
      "realmRoles": [
        "internal"
      ]
    },
    {
      "username": "service-account-notification-svc",
      "enabled": true,
      "serviceAccountClientId": "notification-svc",
      "realmRoles": [
        "internal"
      ]
    },
    {
      "username": "service-account-gateway",
      "enabled": true,
      "serviceAccountClientId": "gateway",
      "realmRoles": [
        "internal"
      ]
    },
    {
      "username": "moderator",
      "email": "moderator@wallpaperhub.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Moderator",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "moderator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "MODERATOR"
      ]
    },
    {
      "username": "admin",
      "email": "admin@wallpaperhub.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ADMIN"
      ]
    }
  ]
}
