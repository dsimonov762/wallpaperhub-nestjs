{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "resources/i18n/*.json", "watchAssets": true },
      { "include": "resources/avro/*.avsc", "watchAssets": true },
      { "include": "resources/proto/**/*.proto", "watchAssets": true }
    ]
  }
}
