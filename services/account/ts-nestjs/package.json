{
  "name": "account-service",
  "version": "0.1.0",
  "private": true,
  "description": "Wallpaper Hub account-service (NestJS)",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "migrate": "nest build && node dist/migrate.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "contracts:sync": "node -e \"const f=require('node:fs');for(const d of ['i18n','avro','proto'])f.cpSync('../../../contracts/'+d,'src/resources/'+d,{recursive:true})\"",
    "test:kafka": "vitest run --config ./vitest.config.kafka.ts",
    "openapi:generate": "nest build && node dist/openapi/cli.js generate",
    "openapi:check": "nest build && node dist/openapi/cli.js check",
    "tls:dev-certs": "node scripts/dev-certs.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/microservices": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/typeorm": "^12.0.2",
    "@platformatic/kafka": "^2.15.0",
    "avsc": "^5.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@peculiar/x509": "^3.1.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
