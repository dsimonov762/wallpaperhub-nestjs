# Copy to .env (git-ignored). Everything here is optional: the "local" profile has sane defaults
# that match infra/docker-compose.yml. Only override what you need.
APP_PROFILE=local
HTTP_PORT=8080
MGMT_PORT=8081
DB_HOST=localhost
DB_PORT=5433
DB_NAME=account
DB_USER=account
DB_PASSWORD=account
# DB_MIGRATE_ON_STARTUP=true
# Token validation. The issuer must equal the `iss` claim Keycloak puts in tokens (the URL clients use to reach it).
# AUTH_ISSUER=http://localhost:8180/realms/wallpaperhub
# Inside Docker networks the service reaches Keycloak by another name; keep the issuer, change only where keys are fetched:
# AUTH_JWKS_URL=http://keycloak:8080/realms/wallpaperhub/protocol/openid-connect/certs

# Redis (rate limiting, idempotency). Default matches infra/docker-compose.yml.
# REDIS_URL=redis://localhost:6379
# Keycloak admin access for registration. URL and realm are derived from AUTH_ISSUER unless set:
# KEYCLOAK_URL=http://keycloak:8080
# KEYCLOAK_REALM=wallpaperhub
# The local profile defaults to the dev secret from infra/keycloak/realm-export.json; other profiles must set it
# (or KEYCLOAK_CLIENT_SECRET_FILE):
# KEYCLOAK_CLIENT_SECRET=dev-secret-account-svc
# Registration limit: burst size, and sustained requests per hour per IP
# RATE_LIMIT_REGISTRATION_BURST=5
# RATE_LIMIT_REGISTRATION_PER_HOUR=30
# Set to true only when running behind the gateway, so X-Forwarded-For is trusted for client IPs
# HTTP_TRUST_PROXY=false

# Kafka and Schema Registry (the local profile defaults match infra/docker-compose.yml; other profiles must set them)
# KAFKA_BROKERS=localhost:9094
# SCHEMA_REGISTRY_URL=http://localhost:8085
# Outbox relay: poll interval (NOTIFY wakes it earlier), batch size, longest retry pause during an outage
# OUTBOX_RELAY_ENABLED=true
# OUTBOX_POLL_INTERVAL_MS=500
# OUTBOX_BATCH_SIZE=100
# OUTBOX_MAX_BACKOFF_MS=30000
# Maintenance jobs: delete published outbox rows after N hours, erase soft-deleted users after N days
# JOBS_ENABLED=true
# OUTBOX_RETENTION_HOURS=168
# USER_PURGE_AFTER_DAYS=30

# gRPC server (internal API, port GRPC_PORT). Rows read per database round trip while streaming:
# GRPC_ENABLED=true
# GRPC_PORT=9090
# GRPC_STREAM_PAGE_SIZE=500

# Profile cache in Redis: switch, TTL (with +/-20% jitter), how long "not found" is remembered, bypass time after a Redis error
# CACHE_ENABLED=true
# CACHE_PROFILE_TTL_SECONDS=300
# CACHE_NEGATIVE_TTL_SECONDS=30
# CACHE_COOLDOWN_MS=5000

# Swagger UI (/api/docs) and the generated OpenAPI document. On in the local profile, off elsewhere (no token needed to read them):
# OPENAPI_ENABLED=true
